[Unit]
Description=Sub2API encrypted reverse forwarding (%i)
After=network-online.target sub2api-web.service
Wants=network-online.target sub2api-web.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@ROOT@/tunnel
ExecStart=/usr/bin/python3 -u @ROOT@/tunnel/supervise.py %i
Restart=always
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
