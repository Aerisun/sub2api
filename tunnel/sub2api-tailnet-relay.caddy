{
	admin off
	auto_https off
}
http://:18082 {
	bind 127.0.0.1
	route {
		rewrite * /sub2api{uri}
		reverse_proxy https://vcl-qiyu-0825.tail246500.ts.net {
			header_up Host {upstream_hostport}
			flush_interval 100ms
			stream_close_delay 5m
			transport http {
				dial_timeout 3s
				response_header_timeout 330s
				keepalive 60s
			}
		}
	}
}
