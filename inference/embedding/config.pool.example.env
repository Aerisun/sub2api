EMBED_WORKER_COUNT=2
EMBED_WORKER_MINIMUM=2
EMBED_WORKER_PHYSICAL_CORES=9
EMBED_WORKER_THREADS=9
EMBED_WORKER_PARALLEL=2
EMBED_WORKER_CONTEXT=16384
EMBED_WORKER_BATCH=8192
EMBED_WORKER_UBATCH=8192
EMBED_WORKER_HTTP_THREADS=8
EMBED_WORKER_IDLE_SECONDS=-1
EMBED_POOL_PORT=8091
