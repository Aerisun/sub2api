[Unit]
Description=Sub2API gateway
After=network-online.target sub2api-postgres.service sub2api-redis.service
Wants=network-online.target
Requires=sub2api-postgres.service sub2api-redis.service

[Service]
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/deployment/private/config/runtime.env
ExecStartPre=@ROOT@/runtime/bin/pg_isready -h 127.0.0.1 -p 55432 -U sub2api -d sub2api
ExecStart=@ROOT@/bin/sub2api
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
