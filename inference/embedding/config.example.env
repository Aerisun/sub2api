# Copy this file to config.env before starting the gateway.
# The bundled scripts use only the Python standard library and SQLite.
EMBED_HOST=127.0.0.1
EMBED_PORT=8090
EMBED_BACKEND_HOST=127.0.0.1
EMBED_BACKEND_PORT=8091
# Use pool only after installing the CPU runtime and config.pool.env.
EMBED_BACKEND_MODE=native
EMBED_MODEL_ALIAS=Qwen3-Embedding-4B
EMBED_PUBLIC_MODEL_ID=qwen3-embedding-4b
EMBED_PARALLEL=2
EMBED_CONTEXT_SIZE=16384
EMBED_THREADS=8
EMBED_BATCH_SIZE=1024
EMBED_UBATCH_SIZE=1024
EMBED_LOG_VERBOSITY=2
EMBED_API_KEY_FILE=secrets/api_keys.txt
EMBED_BACKEND_API_KEY_FILE=secrets/backend_internal_key.txt
EMBED_QUOTA_DB=quota/usage.db
EMBED_BACKEND_TIMEOUT_SECONDS=300
EMBED_MAX_BODY_BYTES=10485760
EMBED_MAX_INPUTS_PER_REQUEST=1024
GATEWAY_MODELS_FILE=gateway_models.json
GATEWAY_DEFAULT_MAX_OUTPUT_TOKENS=4096
EMBED_SUPERVISOR_CHECK_INTERVAL_SECONDS=15
EMBED_SUPERVISOR_FAILURE_THRESHOLD=3

# Optional Tailscale Serve integration. Adjust these for your host.
TAILSCALE_CLI=tailscale
TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
TAILSCALE_PATH=/model
TAILSCALE_URL=https://your-node.example.ts.net/model
