[Unit]
Description=Dedicated Sub2API Codex outbound route
After=network-online.target
Wants=network-online.target

[Service]
Environment=SAFE_PATHS=@ROOT@/deployment/private/egress
ExecStart=@ROOT@/bin/mihomo -d @ROOT@/deployment/private/egress/mihomo-codex -f @ROOT@/deployment/private/egress/mihomo-codex/config.yaml
ExecStartPost=/usr/bin/python3 -m image_hub.egress_ready --config @ROOT@/deployment/private/egress/mihomo-codex/config.yaml --group "Codex egress"
WorkingDirectory=@ROOT@
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
